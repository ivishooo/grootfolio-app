{
  "name": "grootfolio",
  "version": "0.1.0",
  "private": true,
  "description": "GrootFolio - Plataforma de centralización de inversiones personales (TFC Analisis de Sistemas)",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.19.4"
  },
  "scripts": {
    "dev:api": "pnpm --filter @grootfolio/api dev",
    "dev:web": "pnpm --filter @grootfolio/web dev",
    "dev:mobile": "pnpm --filter @grootfolio/mobile start",
    "build": "pnpm -r --filter \"./apps/*\" --filter \"./packages/*\" build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.59.1",
    "eslint": "^9.12.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "prettier": "^3.9.6",
    "typescript": "^5.5.4"
  },
  "lint-staged": {
    "*.{ts,tsx}": ["eslint --fix", "prettier --write"],
    "*.{json,md}": ["prettier --write"]
  },
  "pnpm": {
    "overrides": {
      "react-dom": "^19.0.0",
      "@types/react": "^19.0.0",
      "@types/react-dom": "^19.0.0"
    }
  }
}
