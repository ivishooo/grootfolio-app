# Variables de entorno para el deploy de apps/api (Railway / Fly.io).
# NO commitear el .env real: estos valores van como env vars/secretos en la
# plataforma. Este archivo es solo la referencia de que hay que setear.

# --- Runtime (normalmente ya vienen del Dockerfile/plataforma) ---
NODE_ENV=production
PORT=3333
HOST=0.0.0.0
TZ=America/Argentina/Buenos_Aires
LOG_LEVEL=info

# --- Secretos obligatorios ---
# APP_KEY: generar con `node ace generate:key` (32+ chars).
APP_KEY=
# JWT_SECRET: `openssl rand -base64 48`.
JWT_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- Base de datos ---
# En deploy usar DATABASE_URL (la da el Postgres gestionado). Implica SSL por
# default; si tu proveedor NO usa TLS, poner DB_SSL=false.
DATABASE_URL=postgres://user:password@host:5432/dbname
# DB_SSL=true
# (Alternativa sin connection string: DB_HOST/DB_PORT/DB_USER/DB_PASSWORD/DB_DATABASE)

# --- CORS: origen(es) de la web desplegada (Vercel). Coma-separados. ---
# Sin esto, la web en produccion recibe error de CORS.
CORS_ORIGINS=https://grootfolio.vercel.app

# --- Precios (opcionales; sin key usan el tier free con rate limits bajos) ---
COINGECKO_API_KEY=
COINGECKO_PRICE_TTL_SECONDS=60
COINGECKO_DB_TTL_SECONDS=300
FX_ARS_SOURCE=ccl
FX_TTL_SECONDS=3600

# --- Job de actualizacion de precios (GF-221). En prod conviene activarlo. ---
PRICES_REFRESH_ENABLED=true
PRICES_REFRESH_CRYPTO_SECONDS=120
PRICES_REFRESH_STOCK_SECONDS=300
PRICES_REFRESH_CURRENCY_SECONDS=3600
