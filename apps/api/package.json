{
  "name": "@grootfolio/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "API REST compartida por web y mobile (AdonisJS 6 + Postgres 16)",
  "imports": {
    "#app/*": "./app/*.js",
    "#controllers/*": "./app/controllers/*.js",
    "#middleware/*": "./app/middleware/*.js",
    "#models/*": "./app/models/*.js",
    "#services/*": "./app/services/*.js",
    "#validators/*": "./app/validators/*.js",
    "#exceptions/*": "./app/exceptions/*.js",
    "#config/*": "./config/*.js",
    "#start/*": "./start/*.js",
    "#database/*": "./database/*.js",
    "#commands/*": "./commands/*.js",
    "#providers/*": "./providers/*.js",
    "#tests/*": "./tests/*.js"
  },
  "scripts": {
    "dev": "node --import=ts-node-maintained/register/esm --enable-source-maps ace.js serve --watch",
    "start": "node --import=ts-node-maintained/register/esm bin/server.js",
    "build": "node --import=ts-node-maintained/register/esm ace.js build",
    "migrate": "node --import=ts-node-maintained/register/esm ace.js migration:run",
    "rollback": "node --import=ts-node-maintained/register/esm ace.js migration:rollback",
    "seed": "node --import=ts-node-maintained/register/esm ace.js db:seed",
    "ace": "node --import=ts-node-maintained/register/esm ace.js",
    "test:unit": "node --import=ts-node-maintained/register/esm --test $(find tests/unit -name '*.spec.ts')",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "echo 'TODO(GF-205): habilitar node ace test cuando haya suite Japa' && exit 0"
  },
  "dependencies": {
    "@adonisjs/auth": "^9.2.0",
    "@adonisjs/bouncer": "^3.1.0",
    "@adonisjs/core": "^6.14.0",
    "@adonisjs/cors": "^2.2.1",
    "@adonisjs/lucid": "^21.2.0",
    "@grootfolio/shared": "workspace:*",
    "@vinejs/vine": "^2.1.0",
    "jsonwebtoken": "^9.0.3",
    "luxon": "^3.5.0",
    "pg": "^8.13.0",
    "pino": "^9.4.0",
    "reflect-metadata": "^0.2.2",
    "yahoo-finance2": "^3.15.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@adonisjs/assembler": "^7.8.2",
    "@swc/core": "^1.15.32",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/luxon": "^3.4.2",
    "@types/node": "^22.7.4",
    "pino-pretty": "^11.2.2",
    "ts-node-maintained": "^10.9.4",
    "typescript": "^5.5.4"
  }
}
