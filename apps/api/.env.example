# Variables de entorno para apps/api. Copialas a apps/api/.env y completa los
# valores que no tengan default. La variable APP_KEY se genera con
# `node ace generate:key`.

TZ=America/Argentina/Buenos_Aires
PORT=3333
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info
APP_KEY=

# Database (Postgres 16). El compose de GrootFolio expone Postgres en 5433
# del host para no chocar con un Postgres local en 5432.
DB_HOST=localhost
DB_PORT=5433
DB_USER=grootfolio
DB_PASSWORD=grootfolio
DB_DATABASE=grootfolio_dev

# CORS - lista separada por coma de origenes permitidos. Si esta vacia, usa
# el default (web 5173 + Expo Metro 8081).
CORS_ORIGINS=

# Auth (consumidos por GF-207+)
JWT_SECRET=replace-me-with-openssl-rand-base64-48
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# CoinGecko (GF-217). Demo key gratuita: 30 calls/min, 10k/mes. Obtener en
# https://www.coingecko.com/en/developers/dashboard. Dejar vacio para usar el
# tier free public (sin key, rate limits mas bajos).
COINGECKO_API_KEY=
COINGECKO_PRICE_TTL_SECONDS=60
COINGECKO_DB_TTL_SECONDS=300

# FX / divisas (GF-219). Fuente del dolar para convertir activos en ARS (los
# .BA) a USD base: ccl = dolarapi contado con liqui (default), oficial = BCRA.
# Las demas divisas (EUR, GBP, ...) salen de Frankfurter. FX_TTL_SECONDS: cache
# in-memory de tasas, default 3600s.
FX_ARS_SOURCE=ccl
FX_TTL_SECONDS=3600

# Job de actualizacion periodica de precios (GF-221). Scheduler in-process:
# off por default (se activa con true). Intervalo por tipo de activo, en segundos.
PRICES_REFRESH_ENABLED=false
PRICES_REFRESH_CRYPTO_SECONDS=120
PRICES_REFRESH_STOCK_SECONDS=300
PRICES_REFRESH_CURRENCY_SECONDS=3600

# Observabilidad (GF-185). Sentry se inicializa solo si SENTRY_DSN esta seteada;
# vacia = sin Sentry (no-op). SENTRY_TRACES_SAMPLE_RATE default 0 (sin tracing).
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0

# Chatbot RAG (ADR-0004). GEMINI_API_KEY: key de Google AI Studio; vacia = chat
# deshabilitado (responde "no disponible"). Modelos: se pinean a una version
# concreta (NO se usa gemini-flash-latest) para que la evaluacion de F7 sea
# reproducible. Default gemini-3.6-flash para chat y
# gemini-embedding-001 para embeddings (se pueden overridear); cambiar el de
# embeddings invalida todos los vectores y obliga a `node ace kb:reindex`.
# RAG_TOP_K: cantidad de fragmentos a recuperar (default 4). RAG_MIN_SCORE:
# umbral de similitud coseno [0..1] por debajo del cual el bot NO responde
# (default 0.68, calibrado en F7 con la KB completa). La dimension del embedding esta fijada en
# 768 en la migracion 0008 (gemini-embedding-001 truncado via MRL).
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-3.6-flash
GEMINI_EMBED_MODEL=gemini-embedding-001
RAG_TOP_K=4
RAG_MIN_SCORE=0.68
