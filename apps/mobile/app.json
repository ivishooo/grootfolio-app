{
  "expo": {
    "name": "GrootFolio",
    "slug": "grootfolio",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#0A0A0A"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.grootfolio.app"
    },
    "android": {
      "package": "com.grootfolio.app",
      "adaptiveIcon": {
        "backgroundColor": "#F97316"
      }
    },
    "web": {},
    "extra": {
      "eas": {
        "projectId": "REPLACE_ME"
      }
    },
    "plugins": [
      "expo-font",
      "expo-secure-store"
    ]
  }
}
